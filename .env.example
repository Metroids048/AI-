# ── 平台基础配置 ────────────────────────────────
APP_ENV=development
APP_NAME=ai-quant-research-platform
API_HOST=0.0.0.0
API_PORT=8000
ADMIN_API_TOKEN=dev-admin-token

# ── 基础设施 ─────────────────────────────────────
# NOTE: hosts (timescaledb/redis) resolve inside docker-compose. For host-run
# dev override to localhost. Driver suffix +psycopg is required (psycopg3).
POSTGRES_URL=postgresql+psycopg://postgres:postgres@timescaledb:5432/ai_quant
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── AI ───────────────────────────────────────────
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
# JSON object strings, e.g. {"news_agent":"anthropic","decision_veto_agent":"anthropic"}
AGENT_LLM_PROVIDER_MAP=
# JSON object strings, e.g. {"news_agent":"claude-sonnet-4-6","decision_veto_agent":"claude-sonnet-4-6"}
AGENT_LLM_MODEL_MAP=
OPENROUTER_API_KEY=
# Optional comma-separated override. Empty means discover free catalog at runtime.
OPENROUTER_FREE_MODELS=
GITHUB_MODELS_TOKEN=
# Independent from GITHUB_TOKEN below; used only for GitHub Models inference.
GITHUB_MODELS_FREE_MODELS=
LLM_FREE_MODEL_CATALOG_CACHE_SECONDS=21600

# ── A 级：加密交易所 ──────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true
LIVE_TRADING_ENABLED=false
DEFAULT_EXCHANGE=binance
RUNTIME_SCHEDULER_MODE=inprocess
RUNTIME_SCHEDULER_AUTOSTART=true
PAPER_RUNTIME_CYCLE_SECONDS=300
BINANCE_LIVE_UNIVERSE_ENABLED=false
BINANCE_LIVE_MARKET_ENABLED=false
BINANCE_LIVE_WS_ENABLED=false
BINANCE_LIVE_WS_SYMBOLS=BTC/USDT
BINANCE_LIVE_WS_TIMEFRAME=1m
MARKET_KLINE_STREAM_POLL_SECONDS=2

# ── B 级：宏观数据 ────────────────────────────────
TRADING_ECONOMICS_API_KEY=
ALPHA_VANTAGE_API_KEY=
FOREXFACTORY_RSS_URL=https://forexfactory.com/calendar.rss

# ── C 级：新闻数据 ────────────────────────────────
JINSHI_RSS_URL=https://rss.jin10.com/flash_newest.xml
COINDESK_RSS_URL=https://www.coindesk.com/arc/outboundfeeds/rss/
THEBLOCK_RSS_URL=https://www.theblock.co/rss.xml
REUTERS_CRYPTO_RSS_URL=
SEC_EDGAR_RSS_URL=https://www.sec.gov/cgi-bin/browse-edgar?action=getcurrent&type=&company=&dateb=&owner=include&start=0&count=40&output=atom&q=%22crypto%22

# ── D 级：社交媒体 ────────────────────────────────
TWITTER_BEARER_TOKEN=
TWITTER_WATCH_USER_IDS=25073877,44196397,902926941413453824
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_IDS=
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_DISPATCH_MAX_ATTEMPTS=3
NOTIFICATION_DISPATCH_BASE_DELAY_SECONDS=300

# ── E 级：研究数据 ────────────────────────────────
GITHUB_TOKEN=
ARXIV_CATEGORIES=q-fin.TR,q-fin.PM
# 本地 WorldQuant alpha 库路径（移植方法论到加密，不上传密钥/原始表达式）
WORLDQUANT_ALPHA_LOCAL_PATH=

# ── Freqtrade ────────────────────────────────────
FREQTRADE_API_URL=http://freqtrade:8080
FREQTRADE_USERNAME=freqtradeuser
FREQTRADE_PASSWORD=
